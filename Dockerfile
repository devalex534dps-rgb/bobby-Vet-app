# =============================================================
# Stage 1: Build stage
# =============================================================
FROM node:22-alpine AS builder

WORKDIR /app

# Copy dependency manifests first to leverage Docker layer caching
COPY package.json package-lock.json ./

# Install clean dependencies defined in lockfile
RUN npm ci

# Copy project source code
COPY . .

# Compile TypeScript and build production bundle with Vite
RUN npm run build

# =============================================================
# Stage 2: Production runtime stage
# =============================================================
FROM nginx:1.27-alpine AS runner

# Remove default nginx static files
RUN rm -rf /usr/share/nginx/html/*

# Copy production build artifacts from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Configure Nginx for SPA routing (React Router), gzip compression, and caching
RUN printf '%s\n' \
'server {' \
'    listen 80;' \
'    server_name localhost;' \
'    root /usr/share/nginx/html;' \
'    index index.html;' \
'' \
'    # Security headers' \
'    add_header X-Frame-Options "SAMEORIGIN" always;' \
'    add_header X-Content-Type-Options "nosniff" always;' \
'    add_header Referrer-Policy "strict-origin-when-cross-origin" always;' \
'' \
'    # Gzip Compression' \
'    gzip on;' \
'    gzip_vary on;' \
'    gzip_min_length 1024;' \
'    gzip_proxied any;' \
'    gzip_types text/plain text/css text/xml application/json application/javascript application/xml+rss application/atom+xml image/svg+xml;' \
'' \
'    # SPA routing: fallback all application routes to index.html' \
'    location / {' \
'        try_files $uri $uri/ /index.html;' \
'    }' \
'' \
'    # Long-term cache for immutable hashed assets generated by Vite' \
'    location /assets/ {' \
'        expires 1y;' \
'        add_header Cache-Control "public, max-age=31536000, immutable";' \
'    }' \
'' \
'    # Disable cache for index.html to ensure users always receive latest version' \
'    location = /index.html {' \
'        add_header Cache-Control "no-cache, no-store, must-revalidate";' \
'    }' \
'' \
'    error_page 500 502 503 504 /50x.html;' \
'    location = /50x.html {' \
'        root /usr/share/nginx/html;' \
'    }' \
'}' > /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check to ensure nginx is serving traffic
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start Nginx in foreground mode
CMD ["nginx", "-g", "daemon off;"]
